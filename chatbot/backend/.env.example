# ==================================================
# Chatbot Backend Environment Template
# ==================================================
#
# Fill this file before starting `chatbot/backend`.
#
# Important notes:
# - Use real values, not the placeholder text below.
# - If you use an OpenAI-compatible local gateway, put its URL in the relevant
#   `*_BASE_URL` field and use the model names exposed by that gateway.
# - Some variables below are primary settings, while others are optional
#   fallback settings kept for compatibility with the current code.
#
# Recommended approach:
# 1. Fill the query optimizer section.
# 2. Fill the main LLM section.
# 3. Fill the retrieval section.
# 4. Fill the memory/Qdrant section.
# 5. Fill the LightRAG service URL.


# ==================================================
# Query Optimization
# ==================================================
#
# Used by `query_optimizer.py` before retrieval.
# This model can rewrite vague follow-up questions into a better retrieval query.

# Model name used for query optimization.
# Example: gpt-4o-mini, ministral-3:8b
CHATBOT_QUERY_OPTIMIZER_MODEL=MODEL_NAME

# API key for the query optimizer provider.
# Use the provider key or gateway token expected by CHATBOT_QUERY_OPTIMIZER_BASE_URL.
CHATBOT_QUERY_OPTIMIZER_API_KEY=YOUR_API_KEY

# Base URL for the query optimizer provider.
# Example OpenAI cloud: https://api.openai.com/v1
# Example local gateway: http://102.54.244.89:8088/ollama-v2/api/v1
CHATBOT_QUERY_OPTIMIZER_BASE_URL=BASE_URL

# Request timeout in seconds for query optimization calls.
CHATBOT_QUERY_OPTIMIZER_TIMEOUT_SECONDS=10

# Maximum retry attempts for the optimizer HTTP call.
# Keep this low to avoid slowing down chat responses.
CHATBOT_QUERY_OPTIMIZER_MAX_RETRIES=0

# Set to true only if you intentionally want to skip TLS certificate verification.
# This is usually for internal test gateways only, not production.
CHATBOT_QUERY_OPTIMIZER_INSECURE_TLS=true


# ==================================================
# Retrieval Configuration
# ==================================================
#
# Used by `retrieval_service.py` when calling LightRAG.

# Enable or disable retrieval before answer generation.
CHATBOT_RETRIEVAL_ENABLED=true

# Retrieval mode sent to LightRAG.
# Common values: hybrid, vector, keyword
CHATBOT_RETRIEVAL_SEARCH_TYPE=hybrid

# Number of results requested from LightRAG before local filtering.
CHATBOT_RETRIEVAL_TOP_K=5

# Enable reranking on the LightRAG side.
CHATBOT_RETRIEVAL_ENABLE_RERANKER=true

# Number of candidate chunks passed to the reranker.
CHATBOT_RETRIEVAL_RERANK_TOP_N=10

# Number of final reranked chunks kept as context for the chatbot.
CHATBOT_RETRIEVAL_CONTEXT_TOP_N=4

# Absolute maximum number of chunks allowed in the final prompt context.
CHATBOT_RETRIEVAL_MAX_CHUNKS=5

# Maximum characters allowed per retrieved chunk.
CHATBOT_RETRIEVAL_MAX_CHUNK_CHARS=4000

# Minimum rerank score required to keep a chunk in chatbot context.
# Example: 0.30 means chunks below 0.30 are dropped.
CHATBOT_RETRIEVAL_MIN_RERANK_SCORE=0.30

# If the original query already gets a score above this threshold, the chatbot
# does not need to rely on rewritten/expanded retrieval queries.
CHATBOT_RETRIEVAL_ORIGINAL_SUFFICIENT_SCORE=0.60


# ==================================================
# Main LLM Configuration
# ==================================================
#
# These are shared defaults used by answer generation, summarization, and other
# chatbot components when no more specific override is provided.

# Default API key for the main LLM provider.
OPENAI_API_KEY=YOUR_API_KEY

# Default base URL for the main LLM provider.
# Example OpenAI cloud: https://api.openai.com/v1
# Example local gateway: http://102.54.244.89:8088/ollama-v2/api/v1
OPENAI_BASE_URL=BASE_URL

# Default chat model used when a more specific model variable is not set.
# Example: gpt-4o-mini, ministral-3:8b
LLM_MODEL_NAME=MODEL_NAME

# Tokenizer model used only for token counting.
# Keep this aligned with a tokenizer supported by `tiktoken`.
TIKTOKEN_MODEL_NAME=gpt-4o-mini


# ==================================================
# Chatbot Answer and Summarization Models
# ==================================================
#
# These variables override the default LLM for specific chatbot tasks.

# Model used to summarize long conversations.
# Fallback order in code:
# 1. CHATBOT_SUMMARY_MODEL
# 2. LLM_MODEL_NAME
CHATBOT_SUMMARY_MODEL=MODEL_NAME

# Model used to generate the final chatbot answer.
# Fallback order in code:
# 1. CHATBOT_ANSWER_MODEL
# 2. LLM_MODEL_NAME
CHATBOT_ANSWER_MODEL=MODEL_NAME

# Optional dedicated base URL for answer generation only.
# Leave empty to reuse OPENAI_BASE_URL.
CHATBOT_ANSWER_BASE_URL=

# Trigger summarization after this many messages in the active session.
CHATBOT_SUMMARY_TRIGGER_MESSAGES=12

# Trigger summarization after this many tokens in the active session.
CHATBOT_SUMMARY_TRIGGER_TOKENS=4000

# Number of recent messages to keep after summarization trims older history.
CHATBOT_SUMMARY_KEEP_MESSAGES=4

# Maximum token budget retained after trimming conversation history.
CHATBOT_SUMMARY_TRIM_TOKENS=4000


# ==================================================
# Long-Term Memory Configuration
# ==================================================
#
# Used by `memory_manager.py`.
# This section supports specific memory models plus compatibility fallbacks.

# Optional legacy fallback memory LLM model.
# Used only if CHATBOT_MEMORY_LLM_MODEL is empty.
CHATBOT_MEMORY_MODEL=MODEL_NAME

# Primary LLM model used for memory extraction/update.
# Fallback order in code:
# 1. CHATBOT_MEMORY_LLM_MODEL
# 2. CHATBOT_MEMORY_MODEL
# 3. LLM_MODEL_NAME
CHATBOT_MEMORY_LLM_MODEL=MODEL_NAME

# Primary embedding model used for memory vectors.
# Fallback order in code:
# 1. CHATBOT_MEMORY_EMBEDDING_MODEL
# 2. EMBEDDING_MODEL_NAME
# 3. OPENAI_EMBEDDING_MODEL
CHATBOT_MEMORY_EMBEDDING_MODEL=EMBEDDING_MODEL_NAME

# Embedding vector dimension used for memory storage.
CHATBOT_MEMORY_EMBEDDING_DIM=4096

# Base URL for the memory LLM/embedding provider.
# Leave empty to reuse OPENAI_BASE_URL.
CHATBOT_MEMORY_BASE_URL=BASE_URL

# API key for the memory provider.
# Leave empty to reuse OPENAI_API_KEY.
CHATBOT_MEMORY_API_KEY=YOUR_API_KEY

# Number of memory hits retrieved for each user request.
CHATBOT_MEMORY_TOP_K=5

# Maximum number of existing memories considered during merge/update logic.
CHATBOT_MEMORY_EXISTING_LIMIT=8


# ==================================================
# Embedding Configuration
# ==================================================
#
# Used outside memory as the default embedding setup.

# Optional legacy embedding model name.
# Used only if EMBEDDING_MODEL_NAME is empty in some compatibility paths.
OPENAI_EMBEDDING_MODEL=EMBEDDING_MODEL_NAME

# Primary embedding model used for general retrieval/index-related operations.
# Fallback order in memory code:
# 1. CHATBOT_MEMORY_EMBEDDING_MODEL
# 2. EMBEDDING_MODEL_NAME
# 3. OPENAI_EMBEDDING_MODEL
EMBEDDING_MODEL_NAME=EMBEDDING_MODEL_NAME

# Dimension of the embedding vectors for the selected embedding model.
EMBEDDING_DIM=4096


# ==================================================
# Qdrant Configuration
# ==================================================
#
# Used by chatbot long-term memory.

# Full URL of the Qdrant server.
# Example: http://102.54.244.89:16333
QDRANT_URL=url

# Qdrant collection name used for chatbot memory vectors.
QDRANT_COLLECTION=COLLECTION_NAME

# API key for Qdrant if authentication is enabled.
# Leave empty if your Qdrant instance does not require a key.
QDRANT_API_KEY=YOUR_QDRANT_API_KEY


# ==================================================
# LightRAG Service
# ==================================================
#
# Used by the chatbot retrieval service.

# Base URL of the running LightRAG service.
# Example: http://127.0.0.1:8000
LIGHTRAG_SERVICE_URL=url

# Timeout in seconds for calls from chatbot backend to LightRAG.
LIGHTRAG_TIMEOUT_SECONDS=600
