# ==================================================
# Chatbot Frontend Environment Template
# ==================================================
#
# These variables configure the frontend API targets.
# In local development, they usually point to Vite proxy paths.

# Base path used by the frontend for chatbot backend requests.
# Typical local value: /api/chatbot
VITE_CHATBOT_API_URL=/api/chatbot

# Base path used by the frontend for orchestration requests.
# Typical local value: /api/orchestration
VITE_ORCHESTRATION_API_URL=/api/orchestration

# Base path used by the frontend for upload service requests.
# Typical local value: /api/upload-service
VITE_UPLOAD_SERVICE_API_URL=/api/upload-service
