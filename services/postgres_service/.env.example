# ==================================================
# Postgres Service Environment Template
# ==================================================

# Human-readable service name for logs and diagnostics.
APP_NAME=postgres-service

# Runtime environment name.
# Typical values: development, staging, production
ENVIRONMENT=development

# SQLAlchemy/PostgreSQL connection URL used by postgres_service itself.
# Example:
# postgresql+psycopg://username:password@host:5432/database_name
POSTGRES_URL=postgresql+psycopg://username:password@host:5432/database_name
