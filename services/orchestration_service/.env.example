# ==================================================
# Orchestration Service Environment Template
# ==================================================

# Human-readable service name for logs and diagnostics.
APP_NAME=orchestration-service

# Runtime environment name.
ENVIRONMENT=development

# Base URL of postgres_service.
POSTGRES_SERVICE_URL=http://127.0.0.1:8008

# Base URL of upload_service.
UPLOAD_SERVICE_URL=http://127.0.0.1:8011

# Base URL of docling_service.
DOCLING_SERVICE_URL=http://127.0.0.1:8005

# Base URL of vlm-service.
VLM_SERVICE_URL=http://127.0.0.1:8003

# Base URL of lightrag_service.
LIGHTRAG_SERVICE_URL=http://127.0.0.1:8000

# Base URL of storage_service.
STORAGE_SERVICE_URL=http://127.0.0.1:8012

# Base URL of ORCHESTRATION_SERVICE
ORCHESTRATION_SERVICE_URL=http://127.0.0.1:8002

# Confidence threshold used by orchestration decisions when needed.
CONFIDENCE_THRESHOLD=0.95

# Global request timeout in seconds for downstream service calls.
REQUEST_TIMEOUT_SECONDS=1800

# Poll interval in seconds while waiting for VLM-related completion.
VLM_POLL_INTERVAL_SECONDS=2

# Maximum total polling time in seconds for VLM completion.
VLM_POLL_TIMEOUT_SECONDS=90
