# ==================================================
# VLM Service Environment Template
# ==================================================

# Human-readable service name for logs and diagnostics.
APP_NAME=vlm-service

# Runtime environment name.
ENVIRONMENT=development

# Base URL of postgres_service used to read and update processing metadata.
POSTGRES_SERVICE_URL=http://127.0.0.1:8008

# Base URL of storage_service used to download the source file by document_id.
STORAGE_SERVICE_URL=http://127.0.0.1:8012


# ==================================================
# OCR / VLM API
# ==================================================
#
# Preferred variable names are the VLM_* versions.
# The current code also accepts the legacy aliases BASE_URL, OCR_API_KEY,
# MODEL_ID, PROMPT, PARSE_PROMPT, and REQUEST_TIMEOUT_SECONDS.

# Base URL of the OCR/VLM API.
VLM_BASE_URL=http://102.54.244.89:8088/ocr

# API key used by the OCR/VLM API.
VLM_OCR_API_KEY=YOUR_OCR_API_KEY

# Model name or model identifier exposed by the OCR/VLM API.
VLM_MODEL_ID=Qwen/Qwen3-VL-2B-Instruct

# Prompt sent to the OCR/VLM backend for document extraction.
VLM_PROMPT=qwenvl markdown

# Optional parsing-specific prompt override.
VLM_PARSE_PROMPT=

# Timeout in seconds for one OCR/VLM request.
VLM_REQUEST_TIMEOUT_SECONDS=300


# ==================================================
# VLM retry behavior
# ==================================================

# Maximum number of retries for the remote VLM/OCR request.
VLM_MAX_RETRIES=3

# Sleep time in seconds between VLM retries.
VLM_RETRY_SLEEP_SECONDS=120

# If true, attempt model unload/recovery behavior after CUDA-related failures.
VLM_UNLOAD_MODELS_ON_CUDA_ERROR=true
