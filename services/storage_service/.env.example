# ==================================================
# Storage Service Environment Template
# ==================================================
#
# This service supports Nextcloud, OneDrive, and SharePoint.
# It also keeps some compatibility variables for legacy flows.

# Human-readable service name for logs and diagnostics.
APP_NAME=Enterprise Storage Service

# Runtime environment name.
APP_ENV=development

# Base URL of postgres_service used by storage_service for document metadata.
POSTGRES_SERVICE_URL=http://127.0.0.1:8008

# Default request timeout in seconds for outbound HTTP calls.
REQUEST_TIMEOUT_SECONDS=60


# ==================================================
# OneDrive (Microsoft Graph)
# ==================================================

GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
ONEDRIVE_CLIENT_ID=your-client-id
ONEDRIVE_CLIENT_SECRET=your-client-secret
ONEDRIVE_AUTHORITY=https://login.microsoftonline.com/common
ONEDRIVE_REFRESH_TOKEN=your token
ONEDRIVE_ROOT_FOLDER=HR-Documents
ONEDRIVE_UPLOAD_FOLDER=raw-documents
ONEDRIVE_PROCESSED_FOLDER=processed-documents


# ==================================================
# SharePoint (Power Automate integration)
# ==================================================

SHAREPOINT_POWER_AUTOMATE_URL=your-power-automate-url
SHAREPOINT_FOLDER=/sites/Document-AI-Project/Shared Documents/HR-Documents
SHAREPOINT_UPLOAD_FOLDER=raw-documents
SHAREPOINT_PROCESSED_FOLDER=processed-documents


# ==================================================
# Nextcloud (WebDAV)
# ==================================================

NEXTCLOUD_BASE_URL=http://102.54.244.89:8094
NEXTCLOUD_USERNAME=rag-test
NEXTCLOUD_PASSWORD=your-nextcloud-password
NEXTCLOUD_ROOT_PATH=HR-Documents
NEXTCLOUD_UPLOAD_FOLDER=raw-documents
NEXTCLOUD_PROCESSED_FOLDER=processed-documents


# ==================================================
# Legacy compatibility variables
# ==================================================
#
# These are still accepted by the current code path for compatibility.

# Optional legacy generic storage base URL.
STORAGE_URL=

# Optional legacy generic storage username.
STORAGE_USER=

# Optional legacy generic storage password.
STORAGE_PASSWORD=

# Whether TLS certificate verification is enabled for the legacy storage path.
STORAGE_VERIFY_TLS=true

# Default provider used by legacy-compatible flows.
# Allowed values: nextcloud, onedrive, sharepoint
STORAGE_PROVIDER=nextcloud

# Optional direct PostgreSQL URL kept for compatibility.
POSTGRES_URL=
