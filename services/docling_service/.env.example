# ==================================================
# Docling Service Environment Template
# ==================================================

# Human-readable service name for logs and diagnostics.
APP_NAME=docling-service

# Runtime environment name.
ENVIRONMENT=development

# OCR engine used for PDF/image parsing support inside Docling workflows.
# Typical value in this project: easyocr
PDF_OCR_ENGINE=easyocr

# Languages loaded for French-oriented OCR.
EASYOCR_FRENCH_LANGUAGES=fr,en

# Languages loaded for Arabic-oriented OCR.
EASYOCR_ARABIC_LANGUAGES=ar,en

# Set to true to allow EasyOCR model downloads when models are missing locally.
EASYOCR_DOWNLOAD_ENABLED=true

# Optional custom directory for EasyOCR model files.
# Leave empty to use the default location.
EASYOCR_MODEL_STORAGE_DIRECTORY=

# Optional GPU flag for EasyOCR.
# Leave empty for automatic behavior.
EASYOCR_USE_GPU=

# Layout model name used by Docling.
DOCLING_LAYOUT_MODEL=docling_layout_v2

# Optional path to local Docling artifacts/cache.
# Leave empty if you want the default behavior.
DOCLING_ARTIFACTS_PATH=

# Base URL of postgres_service used by docling_service.
# Typical local value: http://127.0.0.1:8008
POSTGRES_SERVICE_URL=http://127.0.0.1:8008

# Base URL of storage_service used to download the document by document_id.
# Typical local value: http://127.0.0.1:8012
STORAGE_SERVICE_URL=http://127.0.0.1:8012
