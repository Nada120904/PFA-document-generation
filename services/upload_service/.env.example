# ==================================================
# Upload Service Environment Template
# ==================================================
#
# This service uploads files through storage_service and registers metadata
# through postgres_service.

# Human-readable service name for logs and diagnostics.
APP_NAME=upload-service

# Runtime environment name.
ENVIRONMENT=development

# Base URL of the storage service called by upload_service.
# Typical local value: http://127.0.0.1:8012
STORAGE_SERVICE_URL=http://127.0.0.1:8012

# Default storage provider used if the request does not explicitly send one.
# Allowed values in this project: nextcloud, onedrive, sharepoint
STORAGE_PROVIDER=nextcloud

# Base URL of postgres_service used to check duplicates and document metadata.
# Typical local value: http://127.0.0.1:8008
POSTGRES_SERVICE_URL=http://127.0.0.1:8008
