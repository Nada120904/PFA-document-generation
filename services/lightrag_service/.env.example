APP_NAME=rag-service
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==================================================
# LightRAG storage and chunking
# ==================================================

# Working directory where LightRAG stores local state/cache files.
LIGHTRAG_WORKING_DIR=data/lightrag

# Base chunk size used before indexing.
LIGHTRAG_CHUNK_SIZE=500

# Overlap size between adjacent chunks.
LIGHTRAG_CHUNK_OVERLAP_SIZE=50

# Enable hierarchical ingestion/summarization mode.
LIGHTRAG_ENABLE_HIERARCHICAL_INGESTION=true

# Maximum characters used for hierarchical summary text.
LIGHTRAG_HIERARCHICAL_SUMMARY_MAX_CHARS=500

# Enable a post-processing deduplication step for extracted entities.
LIGHTRAG_ENABLE_ENTITY_DEDUP_POSTPROCESS=true

# Maximum payload size per Qdrant upsert request.
QDRANT_UPSERT_MAX_PAYLOAD_BYTES=1048576

# Maximum number of points sent in one Qdrant upsert batch.
QDRANT_UPSERT_MAX_POINTS_PER_BATCH=16


# ==================================================
# Main LLM / embedding gateway
# ==================================================

# Chat model used by LightRAG.
LLM_MODEL_NAME=ministral-3:8b

# Tokenizer model used for token counting.
TIKTOKEN_MODEL_NAME=gpt-4o-mini

# Embedding model used for vectors.
EMBEDDING_MODEL_NAME=qwen3-embedding:latest

# Embedding dimension of the selected embedding model.
EMBEDDING_DIM=4096

# Base URL of the OpenAI-compatible gateway.
# Example local gateway: http://102.54.244.89:8088/ollama-v2/api/v1
OPENAI_BASE_URL=http://102.54.244.89:8088/ollama-v2/api/v1

# API key or gateway token for the OpenAI-compatible endpoint.
OPENAI_API_KEY=

# Set to true only if you intentionally want to skip TLS verification.
OPENAI_INSECURE_TLS=false


# ==================================================
# Timeouts and async limits
# ==================================================

# Maximum concurrent LLM calls used by LightRAG.
LLM_MODEL_MAX_ASYNC=1

# Maximum concurrent embedding calls.
EMBEDDING_FUNC_MAX_ASYNC=1

# Timeout in seconds for LLM calls.
LLM_TIMEOUT=1200

# Timeout in seconds for embedding calls.
EMBEDDING_TIMEOUT=300


# ==================================================
# Reranking
# ==================================================

# Reranking provider.
# Typical value in this project: huggingface
RERANK_BINDING=huggingface

# Reranking model name.
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Rerank batch size.
RERANK_BATCH_SIZE=8

# Minimum rerank score kept after reranking.
MIN_RERANK_SCORE=0.0


# ==================================================
# Database service and vector stores
# ==================================================

# Base URL of postgres_service used by LightRAG metadata calls.
# Typical local value: http://127.0.0.1:8008
DB_SERVICE_BASE_URL=http://127.0.0.1:8008

# Timeout in seconds for HTTP calls to postgres_service.
DB_SERVICE_TIMEOUT=30

# Direct PostgreSQL URL if used by LightRAG internals or scripts.
POSTGRES_URL=postgresql+psycopg://username:password@host:5432/database_name

# Qdrant server URL.
QDRANT_URL=http://your-qdrant-host:6333

# Qdrant API key if authentication is enabled.
QDRANT_API_KEY=

# Set to true only if the Qdrant HTTPS certificate should not be verified.
QDRANT_INSECURE_TLS=false

# Qdrant collection for entities.
QDRANT_COLLECTION_ENTITIES=entities_collection

# Qdrant collection for relationships.
QDRANT_COLLECTION_RELATIONSHIPS=relationships_collection

# Qdrant collection for chunks.
QDRANT_COLLECTION_CHUNKS=chunks_collection

# Optional named vector for entities collection.
QDRANT_VECTOR_NAME_ENTITIES=

# Optional named vector for relationships collection.
QDRANT_VECTOR_NAME_RELATIONSHIPS=

# Optional named vector for chunks collection.
QDRANT_VECTOR_NAME_CHUNKS=

# Neo4j connection URL.
NEO4J_URL=neo4j://localhost:7687

# Neo4j username.
NEO4J_USER=neo4j

# Neo4j password.
NEO4J_PASSWORD=

# Optional Neo4j database name.
NEO4J_DATABASE=neo4j


# ==================================================
# RAGAS evaluation
# ==================================================

# Model used when RAGAS LLM evaluation is enabled.
RAGAS_LLM_MODEL_NAME=ministral-3:8b

# Embedding model used when RAGAS evaluation is enabled.
RAGAS_EMBEDDING_MODEL_NAME=qwen3-embedding:latest


# ==================================================
# Summary merging
# ==================================================

# Force an LLM-generated summary when merging chunks/entities.
FORCE_LLM_SUMMARY_ON_MERGE=true

# Maximum tokens generated for merge summaries.
SUMMARY_MAX_TOKENS=300

# Context size used when building merge summaries.
SUMMARY_CONTEXT_SIZE=6000
